{
  "name": "sojourner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:content": "cargo run --release --bin build_content_db --manifest-path src-tauri/Cargo.toml",
    "build:g2p": "cargo run --release --example build_g2p_lexicon --manifest-path src-tauri/Cargo.toml",
    "fetch:voices": "node tools/fetch-voice-model.mjs",
    "fetch:tunes": "node tools/fetch-psalm-tunes.mjs",
    "import:tunes": "node tools/import-psalm-tunes.mjs",
    "build:psalter": "node tools/build-psalter.mjs",
    "library:collect": "cargo run --release --bin collect_library --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.11",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "epubjs": "^0.3.93",
    "jszip": "^3.10.1",
    "lucide-react": "^1.44.0",
    "pdfjs-dist": "^6.3.289",
    "pptxgenjs": "4.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.5.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.0"
  }
}
