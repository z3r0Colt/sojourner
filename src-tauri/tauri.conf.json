{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sojourner's Study Companion",
  "version": "0.1.0",
  "identifier": "com.sojourner.study",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:content && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sojourner's Study Companion",
        "width": 1280,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' blob:; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: data:; frame-src 'self' blob:; worker-src 'self' blob:; object-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/resources/**", "$RESOURCE/library/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../content/content.db": "content.db",
      "../library/": "library/",
      "../models/": "models/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
