# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Built resource packs (npm run build:pack). Deliberately not under dist/:
# `vite build` empties that folder, and would take a finished 700 MB pack with
# it. Rebuildable from library/, which is committed.
/packs/

# Generated by `npm run build:content` (see src-tauri/src/bin/build_content_db.rs) --
# built from bibles/, commentaries/, reference/ at package time, not committed.
/content/

# The neural voice model, fetched by `npm run fetch:voices` (see
# tools/fetch-voice-model.mjs). ~170 MB of Apache-2.0 weights, bundled into the
# installer at build time so the app never needs the network to speak.
/models/

# /library/ is NOT ignored, and the reason is worth keeping straight: what this
# file excludes is everything the repo can rebuild for itself. content/ comes
# back from `npm run build:content`, models/ from `npm run fetch:voices`, and
# the resource pack from `npm run build:pack`. The books themselves come back
# from nowhere -- `npm run library:collect` gathers them from whatever happens
# to be in one reader's own library on one machine, and
# `tools/stage-library-books.mjs` from a folder that is not in this repo
# either -- so they are source, like bibles/ and commentaries/, and they are
# versioned like source. 267 MB across 270 books, largest file 7.6 MB.
#
# They no longer ship in the installer: `build_library_pack` turns this folder
# into the .sjpack a reader installs separately. That is why the pack build
# output is ignored and this folder is not.

