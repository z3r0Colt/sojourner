# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Generated by `npm run build:content` (see src-tauri/src/bin/build_content_db.rs) --
# built from bibles/, commentaries/, reference/ at package time, not committed.
/content/

# The neural voice model, fetched by `npm run fetch:voices` (see
# tools/fetch-voice-model.mjs). ~170 MB of Apache-2.0 weights, bundled into the
# installer at build time so the app never needs the network to speak.
/models/

# /library/ is NOT ignored, and the reason is worth keeping straight: what this
# file excludes is everything the repo can rebuild for itself. content/ comes
# back from `npm run build:content`, models/ from `npm run fetch:voices`. The
# books that ship with the app come back from nowhere -- `npm run
# library:collect` gathers them from whatever happens to be in one reader's own
# library on one machine -- so they are source, like bibles/ and commentaries/,
# and they are versioned like source. 145 MB, largest file 3.6 MB.

# Editor directories and files
.vscode/*
