.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Build-time downloads (psalm tune scores); regenerate with npm run fetch:tunes
.cache/

# TypeScript incremental build state, written by `tsc -p tsconfig.node.json`.
*.tsbuildinfo
