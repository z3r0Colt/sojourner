<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:SojournersStudy.Models">

    <!--
        Shared between every window that can host a study TabView (the main
        window's embedded one and each StudyTabHostWindow spawned by tearing a
        tab out) so a torn-out tab looks identical in its new window. The root
        of a TabItemTemplate must itself be a TabViewItem when using
        TabItemsSource: the template supplies the whole container, not just
        its header.
    -->
    <DataTemplate x:Key="StudyTabItemTemplate">
        <controls:TabViewItem Header="{Binding Header}">
            <controls:TabViewItem.IconSource>
                <FontIconSource Glyph="{Binding IconGlyph}" />
            </controls:TabViewItem.IconSource>
            <ScrollViewer Padding="16">
                <TextBlock Text="{Binding BodyText}" TextWrapping="Wrap" />
            </ScrollViewer>
        </controls:TabViewItem>
    </DataTemplate>
</ResourceDictionary>
