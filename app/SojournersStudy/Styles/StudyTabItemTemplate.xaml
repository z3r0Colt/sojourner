<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:SojournersStudy.Models"
    xmlns:views="using:SojournersStudy.Views">

    <!--
        Shared between every window that can host a study TabView (the main
        window's embedded one and each StudyTabHostWindow spawned by tearing a
        tab out) so a torn-out tab looks identical in its new window. The root
        of a TabItemTemplate must itself be a TabViewItem when using
        TabItemsSource: the template supplies the whole container, not just
        its header.

        The tab's body is picked per-item by TabContentTemplateSelector (see
        StudyTabItem.Kind) rather than hard-coded here, since different tabs
        (plain text today, interlinear now, more kinds later) need different
        body content built fresh from data in whichever window they land in.
    -->
    <DataTemplate x:Key="PlainTextBodyTemplate">
        <ScrollViewer Padding="16">
            <TextBlock Text="{Binding BodyText}" TextWrapping="Wrap" />
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate x:Key="InterlinearBodyTemplate">
        <views:InterlinearView Words="{Binding InterlinearWords}" />
    </DataTemplate>

    <DataTemplate x:Key="ReadingBodyTemplate">
        <views:ReadingView Book="{Binding ReadingBook}" Chapter="{Binding ReadingChapter}" />
    </DataTemplate>

    <views:TabContentTemplateSelector
        x:Key="TabBodyTemplateSelector"
        InterlinearTemplate="{StaticResource InterlinearBodyTemplate}"
        PlainTextTemplate="{StaticResource PlainTextBodyTemplate}"
        ReadingTemplate="{StaticResource ReadingBodyTemplate}" />

    <DataTemplate x:Key="StudyTabItemTemplate">
        <controls:TabViewItem Header="{Binding Header}">
            <controls:TabViewItem.IconSource>
                <FontIconSource Glyph="{Binding IconGlyph}" />
            </controls:TabViewItem.IconSource>
            <ContentControl
                Content="{Binding}"
                ContentTemplateSelector="{StaticResource TabBodyTemplateSelector}"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />
        </controls:TabViewItem>
    </DataTemplate>
</ResourceDictionary>
