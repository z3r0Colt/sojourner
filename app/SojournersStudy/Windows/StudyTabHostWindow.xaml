<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SojournersStudy.Windows.StudyTabHostWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Sojourner's Study Companion"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <TabView
        x:Name="HostTabView"
        CanTearOutTabs="True"
        TabItemTemplate="{StaticResource StudyTabItemTemplate}"
        TabItemsSource="{x:Bind Items}"
        TabTearOutRequested="HostTabView_TabTearOutRequested"
        TabTearOutWindowRequested="HostTabView_TabTearOutWindowRequested"
        TabWidthMode="Equal" />
</Window>
