<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SojournersStudy.Views.InterlinearView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SojournersStudy.Views"
    xmlns:models="using:SojournersStudy.Data.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="16">
        <ItemsRepeater x:Name="WordsRepeater" ItemsSource="{x:Bind Words, Mode=OneWay}">
            <ItemsRepeater.Layout>
                <StackLayout Orientation="Horizontal" Spacing="20" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="models:OriginalTextWord">
                    <StackPanel
                        Width="96"
                        Padding="6,4"
                        HorizontalAlignment="Center"
                        DoubleTapped="Word_DoubleTapped"
                        ToolTipService.ToolTip="{x:Bind local:InterlinearTooltip.Format(Lemma, StrongsNumber, MorphCode)}">
                        <TextBlock
                            Text="{x:Bind SurfaceWord}"
                            FontFamily="/Assets/Fonts/GentiumPlus-Regular.ttf#Gentium Plus"
                            FontSize="22"
                            TextAlignment="Center"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            Text="{x:Bind MorphCode}"
                            FontSize="11"
                            Margin="0,4,0,0"
                            Opacity="0.6"
                            TextAlignment="Center"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            Text="{x:Bind Gloss}"
                            FontSize="12"
                            FontStyle="Italic"
                            Margin="0,4,0,0"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </ScrollViewer>
</UserControl>
