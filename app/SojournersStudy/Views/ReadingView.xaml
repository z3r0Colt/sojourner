<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SojournersStudy.Views.ReadingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SojournersStudy.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBox
            x:Name="SearchBox"
            Grid.Row="0"
            Margin="24,16,24,0"
            PlaceholderText="Highlight a word in this chapter…"
            TextChanged="SearchBox_TextChanged" />

        <ScrollViewer Grid.Row="1" Padding="24,8,24,24">
            <RichTextBlock
                x:Name="ChapterBlock"
                FontFamily="/Assets/Fonts/EBGaramond-Variable.ttf#EB Garamond"
                FontSize="18"
                IsTextSelectionEnabled="True"
                LineHeight="30"
                TextWrapping="Wrap">
                <Paragraph x:Name="TitleParagraph" FontSize="26" FontWeight="SemiBold" />
                <Paragraph x:Name="ChapterParagraph" />
            </RichTextBlock>
        </ScrollViewer>
    </Grid>
</UserControl>
