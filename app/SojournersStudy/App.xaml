<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SojournersStudy.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SojournersStudy">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles/StudyTabItemTemplate.xaml" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>

            <!--
                Named theme brushes (see ThemeService): these are mutated
                in place at runtime rather than swapped out, since a
                StaticResource binding only resolves once; mutating the
                same brush instance's Color/TintColor is what makes theme
                switching apply live across every control already on
                screen, with no page reload needed.
            -->
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PageForegroundBrush" Color="#1A1A1A" />
            <AcrylicBrush
                x:Key="FloatingMenuBackgroundBrush"
                TintColor="#FFFFFF"
                TintOpacity="0.6"
                FallbackColor="#FFFFFF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
