<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SojournersStudy.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SojournersStudy.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Wires up the Tantivy search engine (built in an earlier phase but
            never used by any UI until now) over Work_Content_Blocks.
            AutoSuggestBox fits this well: type, see live hits as
            suggestions, pick one to jump to that passage.
        -->
        <AutoSuggestBox
            x:Name="SearchBox"
            Grid.Row="0"
            Margin="12,8"
            MaxWidth="500"
            HorizontalAlignment="Left"
            PlaceholderText="Search commentary… (try: grace NEAR(5) covenant)"
            QueryIcon="Find"
            SuggestionChosen="SearchBox_SuggestionChosen"
            TextChanged="SearchBox_TextChanged" />

        <TabView
            x:Name="StudyTabView"
            Grid.Row="1"
            AddTabButtonClick="StudyTabView_AddTabButtonClick"
            CanTearOutTabs="True"
            TabItemTemplate="{StaticResource StudyTabItemTemplate}"
            TabItemsSource="{x:Bind Items}"
            TabTearOutRequested="StudyTabView_TabTearOutRequested"
            TabTearOutWindowRequested="StudyTabView_TabTearOutWindowRequested"
            TabWidthMode="Equal" />
    </Grid>
</Page>
