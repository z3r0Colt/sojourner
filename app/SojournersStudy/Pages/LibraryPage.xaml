<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SojournersStudy.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SojournersStudy.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <TabView
        x:Name="StudyTabView"
        AddTabButtonClick="StudyTabView_AddTabButtonClick"
        CanTearOutTabs="True"
        TabItemTemplate="{StaticResource StudyTabItemTemplate}"
        TabItemsSource="{x:Bind Items}"
        TabTearOutRequested="StudyTabView_TabTearOutRequested"
        TabTearOutWindowRequested="StudyTabView_TabTearOutWindowRequested"
        TabWidthMode="Equal" />
</Page>
